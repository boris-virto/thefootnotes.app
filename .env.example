# Скопируй этот файл в .env и заполни значения.
# Файл .env НЕ коммитим — он в .gitignore.

# Токен телеграм-бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ключ OpenAI (для транскрипции голосовых через Whisper) — https://platform.openai.com/
OPENAI_API_KEY=

# Кто имеет доступ к боту: твой telegram user id (число).
# Узнать свой id можно у бота @userinfobot. Несколько id — через запятую.
# Оставь пустым, чтобы разрешить всем (не рекомендуется).
ALLOWED_USER_IDS=

# Модель Claude для разбора смысла. Опционально.
# claude-opus-4-8 — умнее; claude-haiku-4-5 — дешевле и быстрее для простых заметок.
ANTHROPIC_MODEL=claude-opus-4-8

# Часовой пояс для времени регулярных напоминаний (IANA).
# Примеры: Europe/Belgrade, Europe/Moscow, Europe/Warsaw.
TIMEZONE=Europe/Belgrade

# Локальная модель Whisper для фолбэка, если OpenAI Whisper недоступен.
# tiny/base — легче и быстрее (меньше RAM), small/medium — точнее, но тяжелее.
WHISPER_LOCAL_MODEL=base

# Утренний дайджест: во сколько слать список напоминаний (HH:MM в TIMEZONE).
DIGEST_TIME=09:00

# Куда слать дайджест (telegram chat id). Обычно оставь пустым:
# если в базе один чат — дайджест уйдёт в него автоматически.
DIGEST_CHAT_ID=

# Владелец бота: кому слать уведомления об ошибках сервиса и кому показывать
# трейсбеки прямо в чате. Обычно совпадает с твоим telegram user id.
# Пусто — уведомления об ошибках не шлём.
ADMIN_TELEGRAM_ID=

# Секрет для подписи сессионной куки дашборда (вход по Telegram).
# Можно оставить пустым — тогда секрет выводится из токена бота.
# Задать свой: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Публичный адрес дашборда — бот подставит его в ссылку на вход с телефона (/pair).
# Без слэша на конце. Локально можно оставить пустым.
PUBLIC_URL=https://thefootnotes.app

# Где хранить базу и файлы. По умолчанию — папка data/ рядом с кодом.
DATA_DIR=data

# Адрес базы данных. По умолчанию — SQLite-файл в DATA_DIR.
# Для переезда на PostgreSQL раскомментируй и подставь свои данные
# (и поставь драйвер: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://thefootnotes:пароль@localhost:5432/thefootnotes
